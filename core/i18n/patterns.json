[
  {
    "id": "files-changed-count",
    "pattern": "^(\\d+)\\s+files?\\s+changed$",
    "flags": "i",
    "replace": "$1 个文件已修改"
  },
  {
    "id": "thought-seconds",
    "pattern": "^Thought for\\s+(\\d+(?:\\.\\d+)?)s$",
    "flags": "i",
    "replace": "已思考 $1 秒"
  },
  {
    "id": "thought-minutes",
    "pattern": "^Thought for\\s+(\\d+)m\\s*(\\d+)s$",
    "flags": "i",
    "replace": "已思考 $1 分 $2 秒"
  },
  {
    "id": "step-of-total",
    "pattern": "^Step\\s+(\\d+)\\s+of\\s+(\\d+)$",
    "flags": "i",
    "replace": "第 $1 / $2 步"
  },
  {
    "id": "steps-completed",
    "pattern": "^(\\d+)\\s+of\\s+(\\d+)\\s+steps?\\s+completed$",
    "flags": "i",
    "replace": "已完成 $1 / $2 步"
  },
  {
    "id": "ago-seconds",
    "pattern": "^(\\d+)\\s*s(?:ec(?:ond)?s?)?\\s+ago$",
    "flags": "i",
    "replace": "$1 秒前"
  },
  {
    "id": "ago-minutes",
    "pattern": "^(\\d+)\\s*m(?:in(?:ute)?s?)?\\s+ago$",
    "flags": "i",
    "replace": "$1 分钟前"
  },
  {
    "id": "ago-hours",
    "pattern": "^(\\d+)\\s*h(?:our)?s?\\s+ago$",
    "flags": "i",
    "replace": "$1 小时前"
  },
  {
    "id": "ago-days",
    "pattern": "^(\\d+)\\s*d(?:ay)?s?\\s+ago$",
    "flags": "i",
    "replace": "$1 天前"
  },
  {
    "id": "version-available",
    "pattern": "^Version\\s+([\\d.]+(?:-[\\w.]+)?)\\s+is\\s+available$",
    "flags": "i",
    "replace": "发现新版本 $1"
  },
  {
    "id": "running-tasks-count",
    "pattern": "^(\\d+)\\s+running\\s+tasks?$",
    "flags": "i",
    "replace": "$1 个运行中任务"
  },
  {
    "id": "active-subagents-count",
    "pattern": "^(\\d+)\\s+active\\s+subagents?$",
    "flags": "i",
    "replace": "$1 个活跃子智能体"
  },
  {
    "id": "tools-available",
    "pattern": "^(\\d+)\\s+tools?\\s+available$",
    "flags": "i",
    "replace": "$1 个可用工具"
  },
  {
    "id": "quota-resets-in",
    "pattern": "^Quota\\s+resets?\\s+in\\s+(.+)$",
    "flags": "i",
    "replace": "配额将在 $1 后重置"
  },
  {
    "id": "ai-credits-remaining",
    "pattern": "^([\\d,]+)\\s+AI\\s+credits?\\s+remaining$",
    "flags": "i",
    "replace": "剩余 $1 AI 点数"
  },
  {
    "id": "worked-for-hm",
    "pattern": "^Worked\\s+for\\s+(\\d+)h\\s*(\\d+)m$",
    "flags": "i",
    "replace": "已运行 $1 小时 $2 分钟"
  },
  {
    "id": "worked-for-ms",
    "pattern": "^Worked\\s+for\\s+(\\d+)m\\s*(\\d+)s$",
    "flags": "i",
    "replace": "已运行 $1 分 $2 秒"
  },
  {
    "id": "worked-for-m",
    "pattern": "^Worked\\s+for\\s+(\\d+)m$",
    "flags": "i",
    "replace": "已运行 $1 分钟"
  },
  {
    "id": "worked-for-s",
    "pattern": "^Worked\\s+for\\s+(\\d+(?:\\.\\d+)?)s$",
    "flags": "i",
    "replace": "已运行 $1 秒"
  },
  {
    "id": "your-plan-name",
    "pattern": "^Your\\s+plan:\\s*(.+)$",
    "flags": "i",
    "replace": "当前套餐：$1"
  },
  {
    "id": "available-ai-credits",
    "pattern": "^Available\\s+AI\\s+credits:\\s*([\\d,]+)$",
    "flags": "i",
    "replace": "可用 AI 点数：$1"
  },
  {
    "id": "show-breakdowns",
    "pattern": "^Show\\s+(\\d+)\\s+breakdowns?$",
    "flags": "i",
    "replace": "展开 $1 项明细"
  },
  {
    "id": "see-all-count",
    "pattern": "^See\\s+all\\s*\\((\\d+)\\)$",
    "flags": "i",
    "replace": "查看全部 ($1)"
  },
  {
    "id": "send-feedback-as",
    "pattern": "^Send\\s+feedback\\s+as\\s+(.+)$",
    "flags": "i",
    "replace": "以 $1 身份提交反馈"
  },
  {
    "id": "skills-tokens",
    "pattern": "^Skills:\\s*([\\d,]+)\\s+tokens$",
    "flags": "i",
    "replace": "技能：$1 tokens"
  },
  {
    "id": "weekly-limit-refresh",
    "pattern": "^You have used some of your weekly limit, it will fully refresh in (.+)\\.$",
    "flags": "i",
    "replace": "你已使用部分每周配额，将在 $1 后完全重置。"
  },
  {
    "id": "five-hour-limit-refresh",
    "pattern": "^You have used some of your 5-hour limit, it will fully refresh in (.+)\\.$",
    "flags": "i",
    "replace": "你已使用部分 5 小时配额，将在 $1 后完全重置。"
  },
  {
    "id": "weekly-limit-hit-credits",
    "pattern": "^You have hit your weekly limit, it refreshes in ([^.]+)\\. If on a supported paid plan, you can use AI credits in the interim or upgrade to a higher tier\\.$",
    "flags": "i",
    "replace": "你已达到每周配额上限，将在 $1 后重置。如为支持的付费套餐，期间可使用 AI 点数或升级更高套餐。"
  },
  {
    "id": "weekly-limit-hit-5h-na",
    "pattern": "^You have hit your weekly limit, the 5-hour limit does not currently apply\\. Your weekly limit will fully refresh in (.+)\\.$",
    "flags": "i",
    "replace": "你已达到每周配额上限，5 小时限额当前不适用。每周配额将在 $1 后完全重置。"
  },
  {
    "id": "shortcut-remove-aria",
    "pattern": "^Remove shortcut (.+) for (.+)$",
    "flags": "i",
    "replace": "移除「$2」的快捷键 $1"
  },
  {
    "id": "shortcut-add-aria",
    "pattern": "^Add shortcut for (.+)$",
    "flags": "i",
    "replace": "为「$1」添加快捷键"
  },
  {
    "id": "shortcut-for-aria",
    "pattern": "^Shortcut (.+) for (.+)$",
    "flags": "i",
    "replace": "「$2」的快捷键：$1"
  }
]
